require "fileutils"
require "json"
require "time"

def truthy?(value)
  %w[1 true yes].include?(value.to_s.downcase)
end

def required_path(value, label)
  UI.user_error!("#{label} is required") if value.to_s.empty?
  expanded = File.expand_path(value)
  UI.user_error!("#{label} does not exist: #{expanded}") unless File.file?(expanded)
  expanded
end

def allowed_release_status(value)
  status = value.to_s.empty? ? "completed" : value.to_s
  allowed = %w[completed draft]
  UI.user_error!("PLAY_RELEASE_STATUS must be one of: #{allowed.join(', ')}") unless allowed.include?(status)
  status
end

def package_name
  "com.ashita_motsumono"
end

def repo_root
  # fastlane lanes run with the working directory set to the Fastfile directory.
  File.expand_path("..", __dir__)
end

def play_publisher(options)
  require "google/apis/androidpublisher_v3"
  require "googleauth"

  scope = Google::Apis::AndroidpublisherV3::AUTH_ANDROIDPUBLISHER
  authorization = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: File.open(play_json_key(options)),
    scope: scope,
  )
  publisher = Google::Apis::AndroidpublisherV3::AndroidPublisherService.new
  publisher.authorization = authorization
  publisher
end

def used_version_codes(publisher, package)
  edit = publisher.insert_edit(package)
  tracks = {}
  publisher.list_edit_tracks(package, edit.id).tracks.to_a.each do |track|
    codes = []
    track.releases.to_a.each do |release|
      codes.concat(release.version_codes.to_a.map(&:to_i))
    end
    tracks[track.id] = codes.uniq.sort unless codes.empty?
  end
  apk_codes = publisher
    .list_edit_apks(package, edit.id).apks.to_a
    .map { |apk| apk.version_code.to_i }
    .uniq
    .sort
  [tracks.values.flatten.uniq.sort, tracks, apk_codes]
end

def write_used_version_codes(path, package, codes, tracks, apk_codes)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(
    path,
    JSON.pretty_generate(
      "packageName" => package,
      "usedVersionCodes" => codes,
      "tracks" => tracks,
      "apkVersionCodes" => apk_codes,
      "fetchedAtUtc" => Time.now.utc.iso8601,
    ) + "\n",
  )
end

def play_json_key(options)
  required_path(
    options[:json_key] || ENV["PLAY_SERVICE_ACCOUNT_JSON_PATH"],
    "Google Play service-account JSON",
  )
end

def release_aab(options)
  required_path(
    options[:aab] || ENV["ANDROID_AAB_PATH"] || "build/app/outputs/bundle/release/app-release.aab",
    "signed Android App Bundle",
  )
end

def validate_only?(options)
  truthy?(options[:validate_only] || ENV["PLAY_VALIDATE_ONLY"])
end

def release_status(options)
  allowed_release_status(options[:release_status] || ENV["PLAY_RELEASE_STATUS"])
end

def metadata_path
  File.expand_path("metadata/android", __dir__)
end

def upload_internal(options)
  upload_to_play_store(
    package_name: package_name,
    json_key: play_json_key(options),
    aab: release_aab(options),
    track: "internal",
    release_status: release_status(options),
    metadata_path: metadata_path,
    skip_upload_apk: true,
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
    skip_upload_changelogs: false,
    validate_only: validate_only?(options),
  )
end

def validate_credentials(options)
  validate_play_store_json_key(json_key: play_json_key(options))
end

def print_release_summary(options)
  UI.message("Package: #{package_name}")
  UI.message("Track: internal")
  UI.message("Release status: #{release_status(options)}")
  UI.message("Validate only: #{validate_only?(options)}")
end

def ensure_ci_release_source
  return unless ENV["CI"] == "true"
  UI.user_error!("Internal release must run from master or a v* tag") unless ENV["GITHUB_REF"] == "refs/heads/master" || ENV["GITHUB_REF"].to_s.start_with?("refs/tags/v")
end

def run_internal_release(options)
  ensure_ci_release_source
  print_release_summary(options)
  validate_credentials(options)
  upload_internal(options)
end


default_platform(:android)

platform :android do
  desc "Fetch versionCodes already used on Google Play (fail-fast input for build)"
  lane :play_preflight do |options|
    path = File.expand_path(
      options[:output] || ENV["PLAY_PREFLIGHT_OUTPUT"] || "build/play-release/used-version-codes.json",
      repo_root,
    )
    used, tracks, apk_codes = used_version_codes(play_publisher(options), package_name)
    write_used_version_codes(path, package_name, used, tracks, apk_codes)
    UI.message("Used Google Play versionCodes: #{used.empty? ? '(none)' : used.join(', ')}")
    UI.message("Per-track: #{tracks.map { |id, codes| "#{id}=#{codes.join(',')}" }.join(' ')}")
    UI.success("Play state preflight input written to #{path}")
  end

  desc "Validate the Google Play service-account credential"
  lane :validate_play_credentials do |options|
    validate_credentials(options)
  end

  desc "Upload a signed AAB to the Google Play internal testing track"
  lane :internal do |options|
    run_internal_release(options)
  end
end
